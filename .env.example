# Copy to .env and fill in real values before running docker compose.

# --- Django ---
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend

# --- Database (Postgres) ---
POSTGRES_DB=meeting_notes_summarizer
POSTGRES_USER=meeting_notes_summarizer
POSTGRES_PASSWORD=meeting_notes_summarizer
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# DEV-ONLY: set USE_SQLITE=True to run manage.py commands (check,
# makemigrations, test) against local SQLite when Docker/Postgres aren't
# available, e.g. on a bare dev machine. Never set this in
# docker-compose/production. See backend/config/settings/base.py.
USE_SQLITE=False

# --- CORS ---
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- AI (single chat-completion call, see backend/apps/common/ai.py) ---
# Leave OPENAI_API_KEY unset to use the deterministic offline stub (default
# for local dev/tests - no network, no cost). Set it to call the real
# OpenAI chat completions API.
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-5.6-sol

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:8000/api
